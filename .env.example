# EidosCore — Environment Variables
# Copy this file to .env and fill in values as needed.

# ── Core ──────────────────────────────────────────

# Override the workspace path (default: auto-detect from project markers)
# EIDOS_WORKSPACE=/absolute/path/to/project

# Disable memory injection entirely (same as --no-memory flag)
# EIDOS_NO_MEMORY=1

# Override the default token budget (default: 2000)
# EIDOS_BUDGET=4000

# ── Embedding Model ───────────────────────────────

# Override the embedding model (default: Xenova/all-MiniLM-L6-v2)
# EIDOS_EMBEDDING_MODEL=Xenova/bge-base-en-v1.5

# Custom cache directory for the embedding model (default: ~/.eidos/models)
# TRANSFORMERS_CACHE=/your/custom/cache/dir

# XDG cache home override (used as fallback for model cache)
# XDG_CACHE_HOME=/your/xdg/cache

# ── Sync / Encryption ─────────────────────────────

# Encryption key for cross-machine sync (AES-256-GCM)
# Required when using `eidos sync --folder` or `eidos sync --relay`
# EIDOS_SYNC_KEY=your-32-byte-hex-encoded-key

# ── Summariser ────────────────────────────────────

# Summarizer backend: "local", "ollama:<model>", or "openai:<model>" (default: local)
# EIDOS_SUMMARISER=local

# OpenAI API key (only needed if using openai summariser backend)
# OPENAI_API_KEY=sk-...

# Ollama host (only needed if using ollama summariser backend, default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ── Session ───────────────────────────────────────

# Override session ID (default: auto-generated)
# EIDOS_SESSION_ID=your-session-id

# Auto-approve mode for non-interactive use (default: off)
# EIDOS_AUTO_APPROVE=1

# Model cost per 1k tokens for savings calculation (default: 0.015)
# EIDOS_MODEL_COST=0.015

# ── MCP Server ────────────────────────────────────

# Override MCP server port when running in TCP bridge mode (default: 3742)
# EIDOS_MCP_PORT=3742

# ── Telemetry ─────────────────────────────────────

# Telemetry is controlled via `eidos telemetry on/off` (file-based, not env var)