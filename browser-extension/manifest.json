{
  "name": "Eidos Memory — AI Never Forgets",
  "description": "Universal memory layer for every AI chat. Automatically enriches prompts with your project context from EidosCore.",
  "version": "0.2.0",
  "manifest_version": 3,
  "minimum_chrome_version": "93",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://perplexity.ai/*",
    "*://phind.com/*"
  ],
  "optional_host_permissions": [
    "*://localhost:4141/*",
    "*://localhost:7842/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://perplexity.ai/*",
        "*://phind.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eidos Memory"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
